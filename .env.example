# --- Which AI to use: gemini (free), ollama (free, runs locally), or openai (paid) ---
LLM_PROVIDER=gemini

# Gemini: free key, no credit card -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama (only if LLM_PROVIDER=ollama): install from https://ollama.com, then
#   ollama pull qwen2.5-coder:7b   and   ollama pull nomic-embed-text
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI (only if LLM_PROVIDER=openai; needs paid credit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBED_MODEL=text-embedding-3-small

# --- Database ---
# Leave empty to use the bundled SQLite demo database (data/hospital.db).
# For MySQL: DATABASE_URL=mysql+pymysql://root:password@localhost:3306/hospital
DATABASE_URL=

# --- Engine behaviour ---
MAX_RETRIES=2
TABLE_TOP_K=4
ROW_LIMIT=500
